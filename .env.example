# ─── DATABASE ─────────────────────────────────────────────
POSTGRES_USER=clareon
POSTGRES_PASSWORD=clareon_secret
POSTGRES_DB=clareon_db
DATABASE_URL=postgresql+asyncpg://clareon:clareon_secret@db:5432/clareon_db

# ─── REDIS ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── APP ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── EMAIL ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_NAME=Clareon
EMAILS_FROM_EMAIL=noreply@clareon.app

# ─── STORAGE ──────────────────────────────────────────────
MEDIA_DIR=/app/media
# Future S3 config:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
